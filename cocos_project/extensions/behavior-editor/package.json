{
  "package_version": 2,
  "version": "1.0.0",
  "name": "behavior-editor",
  "label": "Behavior Pattern Editor",
  "description": "Node-graph editor for enemy BehaviorGraph patterns (assets/resources/Data/Behaviors/*.json)",
  "author": "Antigravity",
  "main": "./main.js",
  "panels": {
    "default": {
      "title": "Behavior Pattern Editor",
      "type": "dockable",
      "main": "./panels/default/index.js",
      "size": {
        "min-width": 700,
        "min-height": 500,
        "width": 1000,
        "height": 700
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.extension",
        "label": "Behavior Pattern Editor",
        "message": "openPanel"
      }
    ],
    "messages": {
      "openPanel": {
        "methods": ["openPanel"]
      },
      "list-behaviors": {
        "methods": ["listBehaviors"]
      },
      "load-graph": {
        "methods": ["loadGraph"]
      },
      "save-graph": {
        "methods": ["saveGraph"]
      },
      "create-behavior": {
        "methods": ["createBehavior"]
      },
      "delete-behavior": {
        "methods": ["deleteBehavior"]
      },
      "duplicate-behavior": {
        "methods": ["duplicateBehavior"]
      },
      "rename-behavior": {
        "methods": ["renameBehavior"]
      },
      "load-lib-file": {
        "methods": ["loadLibFile"]
      }
    }
  }
}
