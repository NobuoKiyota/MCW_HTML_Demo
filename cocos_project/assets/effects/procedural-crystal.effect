CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: crystal-vs:vert
      frag: crystal-fs:frag
      properties:
        baseColor:      { value: [0.05, 0.25, 0.6, 1.0], editor: { type: color } }
        glowColor:      { value: [0.3, 0.7, 1.0, 1.0], editor: { type: color } }
        crackColor:     { value: [0.6, 0.9, 1.0, 1.0], editor: { type: color } }
        noiseScale:     { value: 1.5, editor: { tooltip: "ひび割れノイズの大きさ" } }
        fresnelPower:   { value: 3.0, editor: { tooltip: "輪郭反射の鋭さ" } }
        glowIntensity:  { value: 1.0, editor: { tooltip: "発光強度" } }
}%

CCProgram crystal-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>

  in vec3 a_position;
  in vec3 a_normal;
  in vec2 a_texCoord;

  out vec3 v_position;
  out vec3 v_normal;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    vec4 worldPos = cc_matWorld * pos;
    v_position = worldPos.xyz;

    vec3 normal = a_normal;
    if (length(normal) < 0.001) {
      normal = vec3(0.0, 1.0, 0.0);
    }
    v_normal = normalize((cc_matWorldIT * vec4(normal, 0.0)).xyz);

    return cc_matViewProj * worldPos;
  }
}%

CCProgram crystal-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec3 v_position;
  in vec3 v_normal;

  uniform CrystalUniforms {
    vec4 baseColor;
    vec4 glowColor;
    vec4 crackColor;
    float noiseScale;
    float fresnelPower;
    float glowIntensity;
  };

  vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
  vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
  vec4 permute(vec4 x) { return mod289(((x*34.0)+1.0)*x); }
  vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }

  float snoise(vec3 v) {
    const vec2 C = vec2(1.0/6.0, 1.0/3.0);
    const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
    vec3 i  = floor(v + dot(v, C.yyy));
    vec3 x0 = v - i + dot(i, C.xxx);
    vec3 g = step(x0.yzx, x0.xyz);
    vec3 l = 1.0 - g;
    vec3 i1 = min(g.xyz, l.zxy);
    vec3 i2 = max(g.xyz, l.zxy);
    vec3 x1 = x0 - i1 + C.xxx;
    vec3 x2 = x0 - i2 + C.yyy;
    vec3 x3 = x0 - D.yyy;
    i = mod289(i);
    vec4 p = permute(permute(permute(
              i.z + vec4(0.0, i1.z, i2.z, 1.0))
            + i.y + vec4(0.0, i1.y, i2.y, 1.0))
            + i.x + vec4(0.0, i1.x, i2.x, 1.0));
    float n_ = 0.142857142857;
    vec3 ns = n_ * D.wyz - D.xzx;
    vec4 j = p - 49.0 * floor(p * ns.z);
    vec4 x_ = floor(j * ns.z);
    vec4 y_ = floor(j - 7.0 * x_);
    vec4 x = x_ *ns.x + ns.yyyy;
    vec4 y = y_ *ns.x + ns.yyyy;
    vec4 h = 1.0 - abs(x) - abs(y);
    vec4 b0 = vec4(x.xy, y.xy);
    vec4 b1 = vec4(x.zw, y.zw);
    vec4 s0 = floor(b0)*2.0 + 1.0;
    vec4 s1 = floor(b1)*2.0 + 1.0;
    vec4 sh = -step(h, vec4(0.0));
    vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;
    vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;
    vec3 p0 = vec3(a0.xy, h.x);
    vec3 p1 = vec3(a0.zw, h.y);
    vec3 p2 = vec3(a1.xy, h.z);
    vec3 p3 = vec3(a1.zw, h.w);
    vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2, p2), dot(p3,p3)));
    p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
    vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
    m = m * m;
    return 42.0 * dot(m*m, vec4(dot(p0,x0), dot(p1,x1), dot(p2,x2), dot(p3,x3)));
  }

  vec3 safeNormalize(vec3 v) {
    float len = length(v);
    return len > 0.0001 ? v / len : vec3(0.0, 1.0, 0.0);
  }

  vec4 frag () {
    vec3 p = v_position * noiseScale;
    vec3 N = safeNormalize(v_normal);
    vec3 V = safeNormalize(cc_cameraPos.xyz - v_position);
    vec3 L = safeNormalize(-cc_mainLitDir.xyz);

    // 1. ひび割れ
    float n = abs(snoise(p));
    float crack = pow(clamp(1.0 - n, 0.0, 1.0), 6.0);

    // 2. フレネル反射
    float NdotV = clamp(dot(N, V), 0.0, 1.0);
    float fresnel = pow(1.0 - NdotV, clamp(fresnelPower, 0.1, 10.0));

    // 3. ライティング・ハイライト
    float NdotL = max(dot(N, L), 0.2);
    vec3 R = reflect(-V, N);
    float spec = pow(max(dot(R, L), 0.0), 16.0);

    // 4. 安全なカラー合成（すべて 0.0 〜 1.0 にクランプ）
    vec3 baseRgb = mix(baseColor.rgb, glowColor.rgb, fresnel);
    vec3 crackRgb = crackColor.rgb * crack;
    vec3 specRgb = vec3(spec * 0.3);

    vec3 finalRgb = clamp((baseRgb * NdotL + crackRgb + specRgb) * glowIntensity, 0.0, 1.0);

    return vec4(finalRgb, baseColor.a);
  }
}%
