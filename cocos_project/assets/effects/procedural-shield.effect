CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: shield-vs:vert
      frag: shield-fs:frag
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
      rasterizerState:
        cullMode: none
      properties:
        shieldColor:    { value: [0.0, 0.7, 1.0, 0.8], editor: { type: color } }
        rimColor:       { value: [0.5, 0.9, 1.0, 1.0], editor: { type: color } }
        hexScale:       { value: 8.0, editor: { tooltip: "六角形グリッドのサイズ" } }
        rimPower:       { value: 3.0, editor: { tooltip: "輪郭発光の鋭さ" } }
        pulseSpeed:     { value: 2.0, editor: { tooltip: "パルス点滅速度" } }
}%

CCProgram shield-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>

  in vec3 a_position;
  in vec3 a_normal;
  in vec2 a_texCoord;

  out vec3 v_position;
  out vec3 v_normal;
  out vec2 v_uv;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    vec4 worldPos = cc_matWorld * pos;
    v_position = worldPos.xyz;
    v_normal = normalize((cc_matWorldIT * vec4(a_normal, 0.0)).xyz);
    v_uv = a_texCoord;
    return cc_matViewProj * worldPos;
  }
}%

CCProgram shield-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec3 v_position;
  in vec3 v_normal;
  in vec2 v_uv;

  uniform ShieldUniforms {
    vec4 shieldColor;
    vec4 rimColor;
    float hexScale;
    float rimPower;
    float pulseSpeed;
  };

  // 六角形格子パターン生成関数
  float hexGrid(vec2 st) {
    vec2 q = vec2(st.x * 2.0 / 1.7320508, st.y);
    vec2 p = floor(q);
    vec2 f = fract(q);
    float v = mod(p.x + p.y, 2.0);
    return abs(v - length(f - 0.5));
  }

  vec4 frag () {
    vec3 N = normalize(v_normal);
    vec3 V = normalize(cc_cameraPos.xyz - v_position);

    // リムライト（視線と法線の角度による輪郭発光）
    float rim = 1.0 - max(dot(N, V), 0.0);
    rim = pow(rim, rimPower);

    // 六角形パターンの強度計算
    float hex = hexGrid(v_uv * hexScale);
    float hexLine = smoothstep(0.35, 0.45, hex);

    // パルス波動
    float pulse = 0.85 + 0.15 * sin(cc_time.x * pulseSpeed);

    vec3 color = mix(shieldColor.rgb * hexLine, rimColor.rgb, rim) * pulse;
    float alpha = clamp((shieldColor.a * hexLine + rim) * pulse, 0.0, 1.0);

    return vec4(color, alpha);
  }
}%
